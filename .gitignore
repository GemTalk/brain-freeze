# Python
__pycache__/
*.py[cod]

# macOS
.DS_Store

# Working notes kept deliberately out of the repo. This one is a decision memo
# comparing this demo against the one being retired from GemDB_Code; it is for
# a conversation, not for publication. Ignored so `git add -A` cannot sweep it
# in -- which it did once.
docs/two-demos-compared.md

# Agent worktrees and local tooling state, not part of the demo.
.claude/

# The acceptance suite. Its virtualenv carries a browser, and its screenshots
# and payloads are evidence of a run rather than documentation -- the feature
# files are the documentation.
.venv-acceptance/
artifacts/

# Coverage measurement, run on demand rather than committed. `coverage.py`
# cannot see the app at all -- it runs inside GemStone, in another process --
# so this is only ever the CPython half. tests/test_route_coverage.py and the
# acceptance suite are what actually answer "is there a route nobody drives?"
.coverage
htmlcov/

# What the acceptance suite writes at the root to run a published snippet
# the way the document says to run it. Removed by the step that wrote it.
_published_snippet.py

# What finding 9 leaves between its two runs, if a cycle is interrupted.
findings/.finding09_ran
findings/_finding09_helper_*.py
